# Quorum runs fully offline with mocks. Add keys to go live.

# Qloo (hackathon keys only work against hackathon.api.qloo.com)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM (any OpenAI-compatible endpoint; falls back to deterministic mock without a key)
QUORUM_LLM_API_KEY=
QUORUM_LLM_BASE_URL=https://api.openai.com/v1
QUORUM_LLM_MODEL=gpt-4o-mini
